{
  "name": "@starter/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./contract": {
      "types": "./src/contract.ts"
    }
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "bun build src/index.ts src/db/migrate.ts --target=node --outdir=dist --external=pg --external=@google-cloud/storage --external=better-auth --external=@better-auth/expo --external=@better-auth/passkey --external=sharp",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test --path-ignore-patterns='**/*.integration.test.ts' ./src",
    "test:integration": "bun test .integration.test.ts",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --env-file=.env src/db/migrate.ts",
    "storage:init": "bun src/init-local-storage.ts",
    "db:seed": "bun --env-file=.env src/seed.ts"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.17",
    "@better-auth/passkey": "1.7.17",
    "@google-cloud/storage": "8.4.0",
    "@google/genai": "3.0.0",
    "@hono/node-server": "2.1.6",
    "@hono/zod-validator": "0.9.1",
    "@starter/shared": "workspace:*",
    "better-auth": "1.7.17",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "4.13.16",
    "jose": "6.2.3",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@simplewebauthn/server": "13.3.3",
    "@types/pg": "8.23.1",
    "drizzle-kit": "1.0.0-rc.5",
    "emulate": "0.13.0",
    "tsx": "4.23.15"
  }
}
