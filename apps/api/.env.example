NODE_ENV=development
PORT=8080
# Empty uses this worktree's local Compose database. CI/Cloud Run set an explicit URL.
DATABASE_URL=
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Empty uses the worktree API URL. Set the HTTPS tunnel URL for device authentication.
BETTER_AUTH_URL=
TRUSTED_ORIGINS=expo-hono-opentofu-starter://,exp://**
