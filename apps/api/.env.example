NODE_ENV=development
# Compose provides the internal database URL. CI/Cloud Run set an explicit URL.
DATABASE_URL=
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Empty uses the Compose API origin in development. Set the HTTPS tunnel URL for devices.
BETTER_AUTH_URL=
TRUSTED_ORIGINS=expo-hono-opentofu-starter://,exp://**
# Compose injects local Google/Apple/Resend emulators. Never enable in production.
# AUTH_EMULATE=false
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# APPLE_CLIENT_ID=...
# APPLE_CLIENT_SECRET=...
# RESEND_API_KEY=...
# EMAIL_FROM=Login <login@your-verified-domain.example>
# PASSKEY_RP_ID=auth.example.com
# PASSKEY_ORIGINS=https://auth.example.com
# APPLE_APP_ID=TEAM_ID.dev.reohakase.expohonopentofustarter
# ANDROID_SHA256_CERT_FINGERPRINTS=...
