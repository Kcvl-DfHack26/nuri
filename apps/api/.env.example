NODE_ENV=development
# Compose provides the internal database URL. CI/Cloud Run set an explicit URL.
DATABASE_URL=
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Empty uses the Compose API origin in development. Set the HTTPS tunnel URL for devices.
BETTER_AUTH_URL=
TRUSTED_ORIGINS=com.kcvl.nuri://,exp://**
# Compose injects the worktree's bucket and the Floci endpoint. Cloud Run only sets the bucket.
# GCS_BUCKET=
# STORAGE_EMULATOR_HOST=http://floci:4588
# Compose injects local Google/Resend emulators. Never enable in production.
# AUTH_EMULATE=false
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# RESEND_API_KEY=...
# EMAIL_FROM=Login <login@your-verified-domain.example>
# PASSKEY_RP_ID=auth.example.com
# PASSKEY_ORIGINS=https://auth.example.com
# APPLE_APP_ID=TEAM_ID.com.kcvl.nuri
# ANDROID_SHA256_CERT_FINGERPRINTS=...
# Vertex AI for ⑫-3 video analysis. Empty answers 503. Uses gcloud ADC locally.
# VERTEX_PROJECT=kcvlb4
# VERTEX_LOCATION=global

# EXPO_PUSH_ACCESS_TOKEN=...
