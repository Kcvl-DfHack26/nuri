NODE_ENV=development
# Compose provides the internal database URL. CI/Cloud Run set an explicit URL.
DATABASE_URL=
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Empty uses the Compose API origin in development. Set the HTTPS tunnel URL for devices.
BETTER_AUTH_URL=
TRUSTED_ORIGINS=expo-hono-opentofu-starter://,exp://**
