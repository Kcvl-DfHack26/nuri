{
  "name": "@starter/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "bun ../../scripts/dev.ts metro",
    "start": "bun ../../scripts/dev.ts metro",
    "tunnel": "bun ../../scripts/dev.ts metro --tunnel",
    "android": "bun ../../scripts/dev.ts metro --android",
    "ios": "bun ../../scripts/dev.ts metro --ios",
    "web": "bun ../../scripts/dev.ts metro --web",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci --runInBand",
    "export": "expo export --platform ios --platform android",
    "doctor": "expo-doctor",
    "go": "bun ../../scripts/dev.ts metro --go --tunnel"
  },
  "dependencies": {
    "@babel/runtime": "7.29.13",
    "@better-auth/expo": "^1.7.17",
    "@expo/ui": "~58.0.27",
    "@starter/shared": "workspace:*",
    "better-auth": "^1.7.17",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-font": "58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.16",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "expo-web-browser": "~58.0.7",
    "hono": "4.13.16",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@starter/api": "workspace:*",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "expo-doctor": "^1.21.6",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14"
  }
}
