{
  "name": "@starter/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "bun --bun expo start --port 8081 --lan",
    "start": "bun --bun expo start --port 8081 --lan",
    "tunnel": "bun --bun expo start --port 8081 --tunnel ngrok",
    "android": "bun --bun expo start --port 8081 --android",
    "ios": "bun --bun expo start --port 8081 --ios",
    "web": "bun --bun expo start --port 8081 --web",
    "typecheck": "bun --bun expo customize tsconfig.json && test -s .expo/types/router.d.ts && tsc --noEmit",
    "styles:generate": "uniwind generate-artifacts --css ./global.css --dts ./uniwind-types.d.ts",
    "test": "jest --ci --runInBand",
    "export": "bun --bun expo export --platform ios --platform android --platform web",
    "doctor": "bun --bun expo-doctor",
    "go": "bun --bun expo start --port 8081 --go --tunnel ngrok"
  },
  "dependencies": {
    "@babel/runtime": "7.29.13",
    "@bacons/apple-targets": "5.0.0",
    "@better-auth/expo": "^1.7.17",
    "@better-auth/passkey": "1.7.17",
    "@expo-google-fonts/zen-maru-gothic": "0.4.2",
    "@expo/material-symbols": "0.1.1",
    "@expo/plist": "0.5.4",
    "@expo/ui": "~58.0.27",
    "@rn-primitives/slot": "1.5.2",
    "@shopify/react-native-skia": "2.14.0",
    "@starter/shared": "workspace:*",
    "@tanstack/react-query": "5.101.2",
    "better-auth": "^1.7.17",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "expo": "~58.0.23",
    "expo-camera": "58.0.14",
    "expo-constants": "~58.0.15",
    "expo-crypto": "58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "58.0.13",
    "expo-font": "58.0.11",
    "expo-image": "58.0.18",
    "expo-image-picker": "58.0.10",
    "expo-linking": "~58.0.16",
    "expo-network": "~58.0.4",
    "expo-notifications": "58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "expo-video": "58.0.13",
    "expo-video-thumbnails": "58.0.2",
    "expo-web-browser": "~58.0.7",
    "hono": "4.13.16",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-compressor": "2.0.6",
    "react-native-nitro-modules": "0.37.2",
    "react-native-passkey": "3.6.2",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.4",
    "uniwind": "1.13.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@starter/api": "workspace:*",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "expo-doctor": "^1.21.6",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14"
  }
