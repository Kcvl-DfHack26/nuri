# Empty uses DEV_API_ORIGIN in Compose. Set a reachable HTTPS API on physical devices.
EXPO_PUBLIC_API_URL=
# Native passkeys need a development build and domain association, not Expo Go.
# EXPO_PUBLIC_PASSKEY_RP_ID=auth.example.com

# Signed iOS builds use the Apple Developer team for the notification extension.
# APPLE_TEAM_ID=
