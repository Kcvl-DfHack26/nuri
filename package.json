{
  "name": "expo-hono-opentofu-starter",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:mobile": "bun run --cwd apps/mobile dev",
    "dev:api": "bun run --cwd apps/api dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --deny-warnings && eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "bun run --cwd apps/api test:integration",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run deadcode",
    "deadcode": "fallow dead-code",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:migrate": "bun run --cwd apps/api db:migrate",
    "setup": "bun scripts/setup.ts",
    "prepare": "lefthook install",
    "build:api": "bun run --cwd apps/api build",
    "export:mobile": "bun run --cwd apps/mobile export",
    "doctor": "bun run --cwd apps/mobile doctor"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@expo/ngrok": "4.1.3",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "eas-cli": "27.4.1",
    "eslint": "10.14.0",
    "eslint-plugin-drizzle": "0.2.3",
    "eslint-plugin-hono": "1.2.1",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-regexp": "3.3.3",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-turbo": "2.11.10",
    "fallow": "3.39.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-config-universe": "0.2.0",
    "oxlint-tsgolint": "7.0.2005",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "packageManager": "bun@1.4.4"
}
