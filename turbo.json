{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "TRUSTED_ORIGINS",
        "PORT",
        "EXPO_PUBLIC_API_URL",
        "STARTER_CONTAINER",
        "WORKTREE_*",
        "COMPOSE_PROJECT_NAME",
        "PORTLESS_*",
        "CI",
        "EXPO_TUNNEL_SUBDOMAIN",
        "EXPO_NO_TELEMETRY"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^typecheck"],
      "outputs": ["dist/**"]
    }
  },
  "cacheDir": ".turbo/cache"
}
